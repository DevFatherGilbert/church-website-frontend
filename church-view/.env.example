# Backend API connection
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_HOST=localhost
NEXT_PUBLIC_API_PORT=5004
NEXT_PUBLIC_API_PREFIX=api
# Optional: match CLOUDINARY_DELIVERY_HOST when the Cloudinary account uses a custom CDN hostname.
NEXT_PUBLIC_CLOUDINARY_DELIVERY_HOST=
# Canonical site URL (no trailing slash) — used for sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

